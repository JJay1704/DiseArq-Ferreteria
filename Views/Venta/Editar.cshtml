@model Ferreteria.Models.Venta

@{
    ViewData["Title"] = "Editar venta";
}

<div class="container mt-4">
    <h1>Edición de Ventas</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Editar" asp-route-id="@Model.IdVenta" method="post">
                <input asp-for="IdVenta" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Fecha" class="form-label">Fecha</label>
                    <input asp-for="Fecha" class="form-control" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="IdCliente" class="form-label">Cliente</label>
                    <select asp-for="IdCliente" class="form-select" asp-items="ViewBag.IdCliente"></select>
                    <span asp-validation-for="IdCliente" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="IdEmpleado" class="form-label">Empleado</label>
                    <select asp-for="IdEmpleado" class="form-select" asp-items="ViewBag.IdEmpleado"></select>
                    <span asp-validation-for="IdEmpleado" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="IdMetodoPago" class="form-label">Método de pago</label>
                    <select asp-for="IdMetodoPago" class="form-select" asp-items="ViewBag.IdMetodoPago"></select>
                    <span asp-validation-for="IdMetodoPago" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Total" class="form-label">Total</label>
                    <input asp-for="Total" class="form-control" />
                    <span asp-validation-for="Total" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Estado" class="form-label">Estado</label>
                    <select asp-for="Estado" class="form-select" asp-items="ViewBag.Estados"></select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
