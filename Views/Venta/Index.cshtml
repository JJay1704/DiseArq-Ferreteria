@model IEnumerable<Ferreteria.Models.Venta>
@using Ferreteria.States
@{
    ViewData["Title"] = "Ventas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-center align-content-center mb-3">
        <h1>Listado de Ventas</h1>
    </div>
    <a asp-action="Crear" class="btn btn-primary">Nueva Venta</a>
    <hr />
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no hay ventas registradas.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Fecha</th>
                <th>Cliente</th>
                <th>Empleado</th>
                <th>Método de pago</th>
                <th>Total</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var venta in Model)
            {
                <tr>
                    <td>@venta.IdVenta</td>
                    <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@venta.Cliente.Nombres</td>
                    <td>@venta.Empleado.Nombres</td>
                    <td>@venta.MetodoPago.Nombre</td>
                    <td>@venta.Total.ToString("C")</td>
                    <td>@(Enum.IsDefined(typeof(EstadoVenta), venta.Estado) ? ((EstadoVenta)venta.Estado).ToString() : venta.Estado.ToString())</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@venta.IdVenta" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Detalles" asp-route-id="@venta.IdVenta" class="btn btn-info btn-sm">Ver</a>
                        <a asp-action="Eliminar" asp-route-id="@venta.IdVenta" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
