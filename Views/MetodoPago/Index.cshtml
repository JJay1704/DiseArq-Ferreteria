@model IEnumerable<Ferreteria.Models.MetodoPago>
@{
    ViewData["Title"] = "Métodos de Pago";
}
<div class="container mt-4">
    <div class="d-flex justify-content-center align-content-center mb-3">
        <h1>Listado de Métodos de Pago</h1>
    </div>
    <a asp-action="Crear" class="btn btn-primary">Nuevo Método de Pago</a>
    <hr />
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavia no hay métodos de pago registrados
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tipo</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Comisión</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var metodo in Model)
            {
                <tr>
                    <td>@metodo.IdMetPago</td>
                    <td>@metodo.Tipo</td>
                    <td>@metodo.Nombre</td>
                    <td>@metodo.Descripcion</td>
                    <td>@metodo.Comision</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@metodo.IdMetPago" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@metodo.IdMetPago" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
